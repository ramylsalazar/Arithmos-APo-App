<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="24dp"
    android:background="@color/white">

    <ImageButton
        android:id="@+id/btnBack"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:src="@drawable/ic_chevron_right"
        android:rotation="180"
        android:background="?attr/selectableItemBackgroundBorderless"
        app:tint="#0D1B2A"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>

    <TextView
        android:id="@+id/tvPlaybackTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Playback History"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="#0D1B2A"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/btnBack"
        app:layout_constraintStart_toStartOf="parent" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/btnRecordings"
        android:layout_width="match_parent"
        android:layout_height="140dp"
        android:layout_marginTop="32dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="4dp"
        app:layout_constraintTop_toBottomOf="@id/tvPlaybackTitle">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#FFEBEE"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="24dp">
            <ImageView android:layout_width="48dp" android:layout_height="48dp" android:src="@drawable/ic_fiber_manual_record" app:tint="#D32F2F" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="24dp" android:text="Saved Recordings" android:textColor="#0D1B2A" android:textSize="18sp" android:textStyle="bold" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/btnSnapshots"
        android:layout_width="match_parent"
        android:layout_height="140dp"
        android:layout_marginTop="20dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="4dp"
        app:layout_constraintTop_toBottomOf="@id/btnRecordings">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#E1F5FE"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="24dp">
            <ImageView android:layout_width="48dp" android:layout_height="48dp" android:src="@drawable/ic_photo_camera" app:tint="#0288D1" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="24dp" android:text="Saved Snapshots" android:textColor="#0D1B2A" android:textSize="18sp" android:textStyle="bold" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>