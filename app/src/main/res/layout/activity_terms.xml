<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/termsScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:paddingHorizontal="28dp"
        app:layout_constraintBottom_toTopOf="@+id/buttonContainer"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="40dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="48dp"
                android:text="AGREEMENT"
                android:textColor="#BDBDBD"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.1" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Terms of Service"
                android:textColor="#212121"
                android:textSize="32sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Last updated on May 1, 2026"
                android:textColor="#9E9E9E"
                android:textSize="14sp" />

            <View
                android:layout_width="40dp"
                android:layout_height="4dp"
                android:layout_marginTop="32dp"
                android:background="#007AFF" />

            <!-- Clause 1 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:text="1. Our Agreement"
                android:textColor="#212121"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:lineSpacingExtra="8dp"
                android:text="By accessing or using APo, you agree to these Terms and Conditions. We’ve designed this agreement to be easy to read so you understand exactly how your system works."
                android:textColor="#616161"
                android:textSize="15sp" />

            <!-- Clause 2 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:text="2. Purpose &amp; Assistance"
                android:textColor="#212121"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:lineSpacingExtra="8dp"
                android:text="APo is built to help you look after your loved ones by monitoring activity and behavior. Please remember: this system is a tool for assistance, not a replacement for professional medical care, constant human supervision, or emergency response services."
                android:textColor="#616161"
                android:textSize="15sp" />

            <!-- Clause 3 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:text="3. Privacy by Design"
                android:textColor="#212121"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:lineSpacingExtra="8dp"
                android:text="Your privacy is our priority. Unlike many other systems, APo processes everything locally. Your video, images, and activity data are never sent to external or cloud servers. All recordings and snapshots stay on your device, entirely under your control."
                android:textColor="#616161"
                android:textSize="15sp" />

            <!-- Clause 4 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:text="4. Ethical Use &amp; Respect"
                android:textColor="#212121"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:lineSpacingExtra="8dp"
                android:text="Safety works best when it is transparent. By using APo, you agree to inform everyone in the camera’s view that behavioral detection is active. Use the system for safety and assistance only; hidden or unauthorized surveillance is strictly prohibited."
                android:textColor="#616161"
                android:textSize="15sp" />

            <!-- Clause 5 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:text="5. Your Responsibility"
                android:textColor="#212121"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:lineSpacingExtra="8dp"
                android:text="Since your data stays in your home, its security is in your hands. We recommend keeping your local network secure and using a unique, strong Wi-Fi password to protect your camera feed from unauthorized local access."
                android:textColor="#616161"
                android:textSize="15sp" />

            <!-- Clause 6 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:text="6. Understanding Limitations"
                android:textColor="#212121"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:lineSpacingExtra="8dp"
                android:text="While our detection models are advanced, they aren’t perfect. The system may not catch every activity or emergency. APo should be used as a helpful guide, not as the sole source of truth for critical safety decisions."
                android:textColor="#616161"
                android:textSize="15sp" />

            <!-- Clause 7 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:text="7. Liability &amp; Consent"
                android:textColor="#212121"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:lineSpacingExtra="8dp"
                android:text="The developers of APo are not liable for any damages or losses resulting from the use of this application. You are responsible for obtaining proper consent from any individual being monitored, in accordance with local laws."
                android:textColor="#616161"
                android:textSize="15sp" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Sticky Bottom Buttons -->
    <LinearLayout
        android:id="@+id/buttonContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        android:elevation="8dp"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAccept"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="Accept &amp; Continue"
            android:textAllCaps="false"
            android:textSize="16sp"
            android:textStyle="bold"
            app:backgroundTint="#007AFF"
            app:cornerRadius="30dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnScroll"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:paddingHorizontal="40dp"
            android:text="Scroll to Bottom"
            android:textAllCaps="false"
            android:textColor="#212121"
            app:cornerRadius="24dp"
            app:strokeColor="#212121" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>